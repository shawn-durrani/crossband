{
  "_readme": "Copy to config.local.json (gitignored) and edit. Every key is optional and documented in docs/CONFIG.md; delete what you don't use. Machine paths and repo names belong HERE, never in config.json. Note the PYTHONPATH under code_mcp.membro: Membro is not pip-installed, so its module is only importable when its repo root is on PYTHONPATH, which is the form Membro's own README documents.",

  "user_name": "Alex",

  "voice_provider": "auto",

  "code_repos": {
    "myapp": "/Users/you/dev/myapp"
  },
  "github_repos": {
    "myapp": "you/myapp"
  },
  "code_allow_writes": false,

  "code_mcp": {
    "membro": {
      "command": "/Users/you/dev/membro/.venv/bin/python",
      "args": ["-m", "memory_service.mcp_server"],
      "env": { "PYTHONPATH": "/Users/you/dev/membro" }
    }
  },

  "mcp_servers": {
    "my-tool": {
      "command": "/Users/you/dev/my-tool/.venv/bin/python",
      "args": ["/Users/you/dev/my-tool/mcp_server.py"],
      "label": "Checking my-tool"
    }
  },

  "slash_commands": [
    {
      "insert": "/deploy myapp #",
      "label": "/deploy myapp #…",
      "hint": "Ask your own tooling to deploy a PR by number"
    }
  ]
}
