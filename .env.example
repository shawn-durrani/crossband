# --- model providers (at least one required) ---
# Claude participants                    https://console.anthropic.com/
ANTHROPIC_API_KEY=
# GPT participants                       https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- voice (strongly recommended — the headline experience) ---
# Each model answers aloud in its own voice: ElevenLabs Flash streaming TTS +
# Scribe v2 speech-to-text (batch and realtime). Talk over them to barge in.
#                                        https://elevenlabs.io/
ELEVENLABS_API_KEY=

# --- web research (optional; either or both) ---
# Dual-engine search: results are cross-labelled, overlap marked as corroboration.
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- reddit thread fetching (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# --- remote access over Tailscale (optional; see docs/REMOTE_ACCESS.md) ---
# Reach the app privately from your phone. Set to your Mac's tailnet name so the
# app accepts requests proxied by `tailscale serve` (empty = localhost only).
# CROSSBAND_TRUSTED_HOSTS=my-mac.my-tailnet.ts.net

# --- Membro's owner token (see docs/CONFIG.md) ---
# Two consumers, one variable. (1) The chat's own search_history tool: Membro
# owner-gates POST /search even on loopback, so without this token verbatim
# transcript search reports a failure (semantic recall and summaries stay
# available). (2) Summoned guests' membro-admin read server (wired in
# config.local.json's code_mcp) resolves it via ${MEMORY_AUTH_TOKEN} to audit
# exact facts - read-only, never grants writes. Must match Membro's own
# MEMORY_AUTH_TOKEN.
# MEMORY_AUTH_TOKEN=

# --- machine side-channel credential (required once a password is enrolled) ---
# One bearer token authenticates local tooling on POST /api/ingest and
# POST /api/chats/{id}/notice (deploy watchers, schedulers). After owner
# enrolment these routes need it outright - a browser session guards everything
# else, and machine producers have no cookie jar. See docs/CONFIG.md.
# CROSSBAND_INGEST_TOKEN=
